# ============================================================
# VPRP Platform Configuration
# Copy to .env and fill in values. NEVER commit .env to git.
# ============================================================

# ── Environment ───────────────────────────────────────────
VPRP_ENV=development

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_DB=vprp
POSTGRES_USER=vprp_user
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# Full connection string (used by app container)
DATABASE_URL=postgresql://vprp_user:CHANGE_ME_TO_STRONG_PASSWORD@postgres:5432/vprp

# ── Redis (Phase 3+) ─────────────────────────────────────
# REDIS_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
# CELERY_BROKER_URL=redis://:CHANGE_ME_TO_STRONG_PASSWORD@redis:6379/0

# ── Azure AI Foundry (Optional) ──────────────────────────
ENABLE_AI_ENRICHMENT=false
AZURE_AI_ENDPOINT=
AZURE_AI_MODEL=gpt-4o
AZURE_AI_KEY=

# ── Application Settings ─────────────────────────────────
UPLOAD_DIR=/data/uploads
REPORT_DIR=/data/reports
ARCHIVE_DIR=/data/archives
LOG_DIR=/data/logs
MAX_UPLOAD_SIZE_MB=200

# ── Notifications ─────────────────────────────────────────
TEAMS_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=vprp@company.com
SMTP_USE_TLS=true
NOTIFICATION_RECIPIENTS=security-team@company.com,it-ops@company.com
VPRP_BASE_URL=https://100.102.201.9
